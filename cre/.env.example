###############################################################################
### Copy to .env (gitignored). Never commit real values.                    ###
###############################################################################
# A funded Arc-testnet (chain 5042002) key that pays for
# `cre workflow simulate --broadcast`. Gas on Arc is USDC: fund the address
# from the Circle faucet (https://faucet.circle.com, "Arc Testnet").
# Without --broadcast the CLI falls back to a built-in dummy key.
CRE_ETH_PRIVATE_KEY=your-arc-testnet-private-key

# Pyth Hermes (pyth.dourolabs.app) API key, sent as `Authorization: Bearer`.
# Off-chain only: it prices the 12 stock fighters. Leave empty to run with
# stocks flat at 0 bps.
CRE_PYTH_API_KEY=
