# Copy to .env and fill in. Never commit .env.

# ── storage ──────────────────────────────────────────────────────────────────
# Optional locally (unset = in-memory store, nothing survives a restart).
# Required for any deployment.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGODB_DB=mempire
PORT=8787

# Production: lock CORS to the deployed app origin(s), comma-separated.
# Unset = open (development).
CORS_ORIGIN=https://mempire.fun

# ── chain (Arc) ──────────────────────────────────────────────────────────────
# 5042 = Arc mainnet, 5042002 = Arc testnet, 31337 = the local Arc fork from
# scripts/local-up.sh. Contract addresses come from
# shared/deployments/<CHAIN_ID>.json (refresh with `npm run sync-shared`).
CHAIN_ID=5042002
# Defaults: https://rpc.mainnet.arc.io (5042), https://rpc.testnet.arc.io (5042002).
RPC_URL=https://rpc.testnet.arc.io

# The relayer: signs starter-deck mints (MempireCards.relayer() must be this
# address), pays the testnet USDC drip and posts the market meta. NEVER the
# deployer/owner key — the relay refuses a key that owns a game contract.
# Fund it with USDC (Arc gas is USDC). Unset = onboarding answers 503.
RELAYER_PRIVATE_KEY=

# The key whose address the deployed SignedPriceOracle trusts
# (shared/deployments/<id>.json → oracleSigner). It signs live OKX/CoinGecko
# quotes for card mints and the meta keeper. Holds no funds; keep it separate
# from the relayer. Unset = mints answer "no price source configured".
ORACLE_PRIVATE_KEY=

# USDC (native units: "2" = 2 USDC) sent to a new address holding less than
# this. Arc testnet and local forks only — always off on mainnet. Covers a $1
# stake, its session-key gas float and a few mints.
ONBOARD_USDC_DRIP=2

# Arc mainnet only: the relayer mints a free starter deck only for an address
# already holding at least this much USDC (sybil brake on real gas).
ONBOARD_MAINNET_MIN_USDC=1

# ── prices ───────────────────────────────────────────────────────────────────
# Only for a deployment whose oracle is Pyth itself (ORACLE=pyth, Arc testnet):
# Hermes has required a key since 2026-08-26.
PYTH_API_KEY=
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
# Optional CoinGecko demo key; the keyless tier works but rate-limits harder.
COINGECKO_API_KEY=

# Where card art lives, for NFT metadata images (<url>/art/card_<ticker>.png).
PUBLIC_APP_URL=https://mempire.fun

# ── market meta ──────────────────────────────────────────────────────────────
# The relay posts MarketMeta.postFromOracle (signed-oracle momentum). On by
# default on Arc mainnet (CRE doesn't serve it) and local forks; set 1 to run it
# on testnet too, or 0 to turn it off. One post is ~1.7M gas (~0.04 USDC).
META_KEEPER=
# Post every n-th ten-minute window: 6 = hourly (~1 USDC/day), 1 = every window (~6 USDC/day).
META_KEEPER_EVERY=6

# ── Kimi (the AI opponent's strategist and the caster) ───────────────────────
# Unset = /api/ai/* answer 503 and the app offers only the classic bot.
MOONSHOT_API_KEY=
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
# KIMI_MODEL=kimi-k2.6
