# Copy to .env and fill in. Never commit .env.

# ── storage ──────────────────────────────────────────────────────────────────
# Optional. Unset = an in-memory store: fine for local work and tests, and
# nothing survives a restart. Set it for any deployment.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGODB_DB=mempire
PORT=8787

# Production: lock CORS to the deployed app origin(s), comma-separated.
# Unset = open (development).
CORS_ORIGIN=https://mempire.fun

# ── chain ────────────────────────────────────────────────────────────────────
# Which network. Contract addresses come from shared/deployments/<CHAIN_ID>.json
# (refresh with `npm run sync-shared`). 10143 = Monad testnet, 31337 = the local
# fork from scripts/local-up.sh.
CHAIN_ID=10143
RPC_URL=https://testnet-rpc.monad.xyz

# The relayer: signs starter-deck mints (MempireCards.relayer() must be this
# address) and pays the onboarding drip. NEVER the deployer/owner key — the
# relay refuses to use a key that owns a game contract. Fund it with MON for
# gas and drips. Unset = onboarding answers 503.
RELAYER_PRIVATE_KEY=

# Agora's testnet AUSD faucet (requestFunds(address), 60 s global cooldown).
# Unset = no AUSD at onboarding. Only used on test chains.
AUSD_FAUCET=0xd236c18D274E54FAccC3dd9DDA4b27965a73ee6C

# MON sent to a new address that holds less than this. Test chains only.
# Must cover a first staked match: the 0.2 MON session-key float (swept back
# afterwards) plus the stake tx's gas, ~0.23 MON at 100 gwei.
ONBOARD_MON_DRIP=0.25

# ── prices ───────────────────────────────────────────────────────────────────
# Hermes has required a key since 2026-08-26. Unset = /api/pyth/update answers
# 503 and stock prices are left out of /api/coins.
PYTH_API_KEY=
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
# Optional CoinGecko demo key; the keyless tier works but rate-limits harder.
COINGECKO_API_KEY=

# Where card art lives, for NFT metadata images (<url>/art/card_<ticker>.png).
PUBLIC_APP_URL=https://mempire.fun

# ── market meta ──────────────────────────────────────────────────────────────
# 1 = the relay posts MarketMeta.postFromPyth each ten-minute window (Pyth
# momentum). Leave unset when the Chainlink CRE workflow is the meta's writer.
# Always on for the local dev chains (31337/31338).
META_KEEPER=
# Post every n-th window. One post is ~1.7M gas (~0.17 MON), so on testnet use
# 36 (every six hours, ~0.7 MON/day) rather than every window (~25 MON/day).
META_KEEPER_EVERY=1

# LOCAL DEV CHAINS ONLY (31337/31338): the key that signs live quotes for the
# LocalPriceOracle that scripts/local-up.sh deploys. Ignored on any other chain.
ORACLE_PRIVATE_KEY=

# ── Privy (email sign-in, sponsored gas, a policy-bound session signer) ──────
# All four, or Privy is reported "not configured" and email sign-in is hidden.
# The app also needs VITE_PRIVY_APP_ID.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# base64 PKCS8 P-256 private key of the authorization key registered as a signer.
PRIVY_AUTHORIZATION_KEY=
# The key quorum id of that authorization key.
PRIVY_SIGNER_ID=
# Optional: an existing policy; unset = created at boot (mempire-match-actions).
PRIVY_POLICY_ID=

# ── Kimi (the AI opponent's strategist and the caster) ───────────────────────
# Unset = /api/ai/* answer 503 and the app offers only the classic bot.
MOONSHOT_API_KEY=
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
# KIMI_MODEL=kimi-k2.6
