# Copy to .env and fill in. Never commit .env.

# ── storage ──────────────────────────────────────────────────────────────────
# Optional locally (unset = in-memory store, nothing survives a restart).
# Required for any deployment.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGODB_DB=mempire
PORT=8787

# Production: lock CORS to the deployed app origin(s), comma-separated.
# Unset = open (development).
CORS_ORIGIN=https://mempire.fun

# ── chain (Arc) ──────────────────────────────────────────────────────────────
# 5042 = Arc mainnet, 5042002 = Arc testnet, 31337 = the local Arc fork from
# scripts/local-up.sh. Contract addresses come from
# shared/deployments/<CHAIN_ID>.json (refresh with `npm run sync-shared`).
CHAIN_ID=5042002
# Defaults: https://rpc.mainnet.arc.io (5042), https://rpc.testnet.arc.io (5042002).
RPC_URL=https://rpc.testnet.arc.io

# The relayer: signs starter-deck mints (MempireCards.relayer() must be this
# address), pays the testnet USDC drip, posts the market meta, submits Circle
# Gateway mints, completes stored CCIP instructions and (testnet) updates the
# Chainlink feed mirrors. NEVER the
# deployer/owner key — the relay refuses a key that owns a game contract.
# Fund it with USDC (Arc gas is USDC). Unset = onboarding answers 503.
RELAYER_PRIVATE_KEY=

# USDC (native units: "2" = 2 USDC) sent to a new address holding less than
# this. Arc testnet and local forks only — always off on mainnet. Covers a $1
# stake, its session-key gas float and a few mints.
ONBOARD_USDC_DRIP=2

# Arc mainnet only: the relayer mints a free starter deck only for an address
# already holding at least this much USDC (sybil brake on real gas).
ONBOARD_MAINNET_MIN_USDC=1

# ── prices ───────────────────────────────────────────────────────────────────
# Every fighter's price is its Chainlink Data Feed on Arc (read from the
# addresses MempireCards registered) — no key needed. OKX's public tickers add
# the 24h change shown beside it (display only).

# Where card art lives, for NFT metadata images (<url>/art/card_<ticker>.png).
PUBLIC_APP_URL=https://mempire.fun

# ── market meta ──────────────────────────────────────────────────────────────
# The relay calls MarketMeta.postFromFeeds (the contract computes each
# fighter's 24h move from its Chainlink feed; the relay only names the day-ago
# round). On by default on Arc mainnet and local forks; 1 to run it on testnet
# too, 0 to turn it off. One post is ~1M gas (~0.02–0.03 USDC).
META_KEEPER=
# Post every n-th ten-minute window: 6 = hourly (~0.5 USDC/day).
META_KEEPER_EVERY=6

# ── Kimi (the AI opponent's strategist and the caster) ───────────────────────
# Unset = /api/ai/* answer 503 and the app offers only the classic bot.
MOONSHOT_API_KEY=
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
# KIMI_MODEL=kimi-k2.6

# ── Arc stack ────────────────────────────────────────────────────────────────
# ERC-8004 agent id of the AI opponent (scripts/register-agent.mjs prints it).
# Unset = the app hides the rating buttons.
AI_AGENT_ID=
# Public origin of this relay, used in the agent card's endpoint.
PUBLIC_API_URL=https://api.mempire.fun
# Circle Gateway: most a single relayed top-up may mint on mainnet (USDC).
GATEWAY_MAX_TOPUP=100
# Arc testnet only: where the feed mirror reads Chainlink's mainnet feeds.
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
