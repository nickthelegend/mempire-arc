# Copy to .env.local (or set in the host's dashboard). All optional in local dev.

# The relay: matchmaker, onboarding, price signing, NFT metadata. ws:// is derived.
VITE_API_URL=http://localhost:8787

# Which Arc network this build talks to:
#   5042    = Arc mainnet
#   5042002 = Arc testnet (default)
#   31337   = the local Arc-testnet fork from scripts/local-up.sh (arc-anvil :8710)
# Contract addresses come from src/shared/deployments/<id>.json (npm run sync-shared).
VITE_CHAIN_ID=5042002

# Optional RPC override. Defaults: https://rpc.mainnet.arc.io, https://rpc.testnet.arc.io,
# http://127.0.0.1:8710 for the fork.
# VITE_RPC_URL=

# Optional: the Envio GraphQL endpoint that powers the Live-on-Arc panel.
# VITE_INDEXER_URL=

# Build-time only: allow a bundle with no deployment for VITE_CHAIN_ID (CI, practice mode).
# ALLOW_NO_DEPLOYMENT=1

# Cross-chain entry (Chainlink CCIP + CCTP): MempireRemoteEntry on each source
# chain (scripts/deploy-remote.sh prints them). Unset = "entry not deployed yet".
# VITE_REMOTE_ENTRY_BASE=
# VITE_REMOTE_ENTRY_ETHEREUM=
